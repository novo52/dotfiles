alias reload="source $ZDOTDIR/.zshrc"

ls-seperated () {
	BASE_PATH=''
	[[ ((${#*[@]} > 0)) ]] && [[ $@[-1] != -(*) ]] && BASE_PATH="$@[-1]"
		OUTPUT=`command ls --color --file-type --group-directories-first -w $COLUMNS -xdh --hide="[^.]*" $@` && [[ "$OUTPUT" != $'./\n' ]] && echo "$OUTPUT" && echo
	#HIDDEN=($BASE_PATH/.*(N))
	#[[ -n "$HIDDEN" ]] && OUTPUT=`command ls --color --file-type --group-directories-first -w $COLUMNS -xdh $@ $HIDDEN` && [[ -n "$OUTPUT" ]] && echo "$OUTPUT" && echo
	lsb $@
}

alias ls='LC_ALL=C ls --color=auto -hF'

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias vim='nvim'

# --load-average bounds the build by machine load rather than by core count,
# which matters on hosts shared with other people: coronation reports 128 threads.
export NUMCPUS=`grep -c '^processor' /proc/cpuinfo`
alias make='nice make -j$NUMCPUS --load-average=$NUMCPUS'
alias cmake='nice cmake'

# Tools that are present on some machines only.
(( $+commands[difft] )) && alias difft='difft --display=side-by-side-show-both'
# -p because the TUI (-t) renders a file given on the command line unwrapped
(( $+commands[glow] )) && alias glow='glow -w $(tput cols) -p'

# Defined after the glow alias so the alias is expanded in the body.
function open {
	if [[ $1 == *.md ]] && (( $+commands[glow] )); then
		glow "$@"
	elif (( $+commands[explorer.exe] )); then
		# WSL: a Linux handler if one is registered, else the Windows default app.
		(( $+commands[xdg-open] )) && xdg-open "$@" &> /dev/null && return
		if (( $+commands[wslview] )); then
			wslview "$@"
		else
			# explorer.exe exits 1 even when it succeeds.
			explorer.exe "$([[ -e $1 ]] && wslpath -w "$1" || print -r -- "$1")"
			return 0
		fi
	elif (( $+commands[xdg-open] )); then
		xdg-open "$@"
	elif (( $+commands[wslview] )); then
		wslview "$@"
	else
		print -u2 "open: no handler for $1"
		return 1
	fi
}
